{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SkillMatch: Django",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": [
        "runserver",
        "127.0.0.1:8000",
        "--noreload"
      ],
      "django": true,
      "justMyCode": true,
      "env": {
        "DJANGO_DEBUG": "1"
      },
      "console": "integratedTerminal"
    }
  ]
}
