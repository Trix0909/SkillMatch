# Copy to .env in the project root for local development; never commit .env.
# Existing shell variables take precedence. Hosting DJANGO_DEBUG=0 skips .env.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
# DJANGO_SECRET_KEY=generate-a-unique-secret-for-production
# SKILLMATCH_DB=/absolute/path/to/persistent/db.sqlite3
# DJANGO_HTTPS=1

# Optional provider sign-in. Both values are required to enable a provider button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
