# Reference configuration; set these as shell/deployment environment variables.
# The application does not automatically load .env files.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
# DJANGO_SECRET_KEY=generate-a-unique-secret-for-production
# SKILLMATCH_DB=/absolute/path/to/persistent/db.sqlite3
# DJANGO_HTTPS=1

# Optional provider sign-in. Both values are required to show a provider button.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
